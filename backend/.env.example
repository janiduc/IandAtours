ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://iandatours:iandatours@localhost:5432/iandatours
CORS_ORIGINS=["http://localhost:5173"]

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public addresses of the website and API (used in payment links)
SITE_URL=http://localhost:5173
API_URL=http://localhost:8000

# PayHere: leave empty to take booking requests without online payment.
# Sandbox credentials: https://sandbox.payhere.lk  ·  Live: https://www.payhere.lk
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# AI assistant (trip planner + staff assistant). Leave LLM_MODEL empty to switch it off.
# Free options:
#   Ollama on your computer: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b
#   Groq free tier:          LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile  LLM_API_KEY=...
#   Gemini free tier:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash  LLM_API_KEY=...
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
